table _Medidas
	lineageTag: b0000000-0000-4000-8000-000000000001

	measure 'Demanda Real' = SUM(Fact_Demanda_Horaria[demanda])
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000010

	measure 'Demanda Real Promedio' =
			AVERAGEX(
				VALUES(Dim_Calendario[datetime]),
				CALCULATE(SUM(Fact_Demanda_Horaria[demanda]))
			)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000028

	measure 'Demanda Real Ventana' =
			VAR HorasAtras = SELECTEDVALUE(Dim_Ventana_Historica[horas_atras], 720)
			VAR UltimoOrigen = MAX(Fact_Pronostico[fecha_origen])
			VAR MinFecha = UltimoOrigen - (HorasAtras / 24.0)
			VAR CurrentDateTime = MAX(Dim_Calendario[datetime])
			RETURN
				IF(
					CurrentDateTime >= MinFecha && CurrentDateTime <= UltimoOrigen,
					CALCULATE(SUM(Fact_Demanda_Horaria[demanda])),
					BLANK()
				)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000029

	measure 'Demanda Pronosticada' =
			CALCULATE(
				SUM(Fact_Pronostico[predicho]),
				Fact_Pronostico[es_modelo_seleccionado] = TRUE()
			)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000011

	measure 'Banda Superior 80%' =
			CALCULATE(
				SUM(Fact_Pronostico[predicho_sup_80]),
				Fact_Pronostico[es_modelo_seleccionado] = TRUE()
			)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000012

	measure 'Banda Inferior 80%' =
			CALCULATE(
				SUM(Fact_Pronostico[predicho_inf_80]),
				Fact_Pronostico[es_modelo_seleccionado] = TRUE()
			)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000013

	measure 'Umbral P95' =
			CALCULATE(
				SUM(Fact_Pronostico[threshold_p95]),
				Fact_Pronostico[es_modelo_seleccionado] = TRUE()
			)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000014

	measure 'Demanda Media Prevista' =
			AVERAGEX(
				VALUES(Dim_Calendario[datetime]),
				[Demanda Pronosticada]
			)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000015

	measure 'Pico Estimado' =
			MAXX(
				VALUES(Dim_Calendario[datetime]),
				[Demanda Pronosticada]
			)
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000016

	measure 'Hora Pico Estimado' =
			VAR MaxVal = [Pico Estimado]
			VAR PeakDt =
				CALCULATE(
					SELECTEDVALUE(Dim_Calendario[datetime]),
					FILTER(
						VALUES(Dim_Calendario[datetime]),
						[Demanda Pronosticada] = MaxVal
					)
				)
			VAR Horiz = SELECTEDVALUE(Dim_Horizonte[horizonte], "24 horas")
			RETURN
				IF(
					ISBLANK(PeakDt),
					"-",
					IF(
						Horiz = "24 horas",
						FORMAT(PeakDt, "HH:mm"),
						FORMAT(PeakDt, "dd mmm · HH:mm", "es-ES")
					)
				)
		lineageTag: b0000000-0000-4000-8000-000000000017

	measure 'Horas Demanda Elevada' =
			COUNTROWS(
				FILTER(
					VALUES(Dim_Calendario[datetime]),
					[Demanda Pronosticada] >= [Umbral P95] && NOT ISBLANK([Demanda Pronosticada])
				)
			)
		formatString: 0
		lineageTag: b0000000-0000-4000-8000-000000000018

	measure 'Pct Horas Elevadas' =
			VAR Num = [Horas Demanda Elevada]
			VAR Denom = COUNTROWS(FILTER(VALUES(Dim_Calendario[datetime]), NOT ISBLANK([Demanda Pronosticada])))
			RETURN
				DIVIDE(Num, Denom, 0)
		formatString: 0.0 %
		lineageTag: b0000000-0000-4000-8000-000000000019

	measure 'Probabilidad Pico Horizonte' =
			IF(
				HASONEVALUE(Dim_Zona[zona_id]),
				CALCULATE(
					AVERAGE(Fact_Probabilidad_Pico[probabilidad_al_menos_un_pico]),
					Fact_Probabilidad_Pico[es_modelo_seleccionado] = TRUE()
				),
				CALCULATE(
					MAX(Fact_Probabilidad_Pico[probabilidad_red_al_menos_un_pico]),
					Fact_Probabilidad_Pico[es_modelo_seleccionado] = TRUE()
				)
			)
		formatString: 0.0 %
		lineageTag: b0000000-0000-4000-8000-000000000020

	measure 'Probabilidad Pico Zona' =
			CALCULATE(
				AVERAGE(Fact_Probabilidad_Pico[probabilidad_al_menos_un_pico]),
				Fact_Probabilidad_Pico[es_modelo_seleccionado] = TRUE()
			)
		formatString: 0.0 %
		lineageTag: b0000000-0000-4000-8000-000000000030

	measure 'Probabilidad Pico Red Conjunta' =
			CALCULATE(
				MAX(Fact_Probabilidad_Pico[probabilidad_red_al_menos_un_pico]),
				Fact_Probabilidad_Pico[es_modelo_seleccionado] = TRUE()
			)
		formatString: 0.0 %
		lineageTag: b0000000-0000-4000-8000-000000000031

	measure 'Probabilidad Promedio de Pico por Zona' =
			CALCULATE(
				AVERAGE(Fact_Probabilidad_Pico[probabilidad_al_menos_un_pico]),
				Fact_Probabilidad_Pico[es_modelo_seleccionado] = TRUE()
			)
		formatString: 0.0 %
		lineageTag: b0000000-0000-4000-8000-000000000032

	measure 'Demanda Media KPI Formato' =
			VAR Val = [Demanda Media Prevista]
			RETURN
				IF(ISBLANK(Val), "-", FORMAT(Val / 1000, "#,##0.0") & " mil")
		lineageTag: b0000000-0000-4000-8000-000000000021

	measure 'Pico Estimado KPI Formato' =
			VAR Val = [Pico Estimado]
			RETURN
				IF(ISBLANK(Val), "-", FORMAT(Val / 1000, "#,##0.0") & " mil")
		lineageTag: b0000000-0000-4000-8000-000000000022

	measure 'Resumen Perspectiva Dinamica' =
			VAR Media = [Demanda Media Prevista]
			VAR Pico = [Pico Estimado]
			VAR HoraPico = [Hora Pico Estimado]
			VAR HorasElevadas = [Horas Demanda Elevada]
			RETURN
				"Se proyecta una demanda media de " & FORMAT(Media, "#,##0") & " unidades, con un pico estimado de " & FORMAT(Pico, "#,##0") & " alrededor de las " & COALESCE(HoraPico, "-") & ". Se esperan " & COALESCE(HorasElevadas, 0) & " periodos con demanda elevada (por encima del P95)."
		lineageTag: b0000000-0000-4000-8000-000000000023

	measure 'Alerta Estado Operativo' =
			VAR Prob = [Probabilidad Pico Horizonte]
			VAR HorasElevadas = [Horas Demanda Elevada]
			RETURN
				IF(
					Prob >= 0.50 || HorasElevadas > 0,
					"Se anticipan picos de demanda en el horizonte seleccionado.",
					"Comportamiento dentro de los rangos normales esperados."
				)
		lineageTag: b0000000-0000-4000-8000-000000000024

	measure 'Temperatura Promedio Contexto' =
			VAR Temp = AVERAGE(Fact_Demanda_Horaria[temperatura])
			RETURN
				IF(ISBLANK(Temp), "-", "🌡 " & FORMAT(Temp, "0.0") & " °C")
		lineageTag: b0000000-0000-4000-8000-000000000025

	measure 'Humedad Promedio Contexto' =
			VAR Hum = AVERAGE(Fact_Demanda_Horaria[humedad])
			RETURN
				IF(ISBLANK(Hum), "-", "💧 " & FORMAT(Hum, "0.0") & " %")
		lineageTag: b0000000-0000-4000-8000-000000000026

	measure 'Viento Promedio Contexto' =
			VAR Vnt = AVERAGE(Fact_Demanda_Horaria[viento])
			RETURN
				IF(ISBLANK(Vnt), "-", "💨 " & FORMAT(Vnt, "0.0") & " km/h")
		lineageTag: b0000000-0000-4000-8000-000000000027

	measure 'Evento Pico Estimado' =
			VAR Pred = [Demanda Pronosticada]
			VAR Umbral = [Umbral P95]
			RETURN
				IF(Pred >= Umbral && NOT ISBLANK(Pred) && NOT ISBLANK(Umbral), Pred, BLANK())
		formatString: #,##0
		lineageTag: b0000000-0000-4000-8000-000000000033

	column Columna1
		dataType: string
		isHidden
		lineageTag: b0000000-0000-4000-8000-000000000002
		summarizeBy: none
		isNameInferred
		sourceColumn: [Columna1]

		annotation SummarizationSetBy = Automatic

	measure 'Mapa Red Distribucion' = "data:image/jpeg;base64,"
		dataCategory: ImageUrl
		lineageTag: b0000000-0000-4000-8000-000000000034

	partition _Medidas = calculated
		mode: import
		source = ROW("Columna1", BLANK())

